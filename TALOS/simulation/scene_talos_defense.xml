<mujoco model="TALOS G1 Defense Scenario">
  <!-- Inclusion du modèle officiel G1 29 DDL -->
  <include file="../../unitree_mujoco/unitree_robots/g1/g1_29dof.xml"/>

  <statistic center="1.5 0 0.8" extent="4.0"/>

  <visual>
    <headlight diffuse="0.7 0.7 0.7" ambient="0.3 0.3 0.3" specular="0.1 0.1 0.1"/>
    <rgba haze="0.1 0.15 0.25 1"/>
    <global azimuth="-120" elevation="-25"/>
  </visual>

  <asset>
    <!-- Ciel et environnement tactique -->
    <texture type="skybox" builtin="gradient" rgb1="0.15 0.2 0.3" rgb2="0.05 0.05 0.08" width="512" height="3072"/>
    <texture type="2d" name="ground_tactical" builtin="checker" mark="edge" rgb1="0.25 0.27 0.28" rgb2="0.18 0.20 0.22" markrgb="0.4 0.45 0.35" width="400" height="400"/>
    <material name="ground_mat" texture="ground_tactical" texuniform="true" texrepeat="10 10" reflectance="0.1" roughness="0.8"/>
    
    <!-- Matériaux obstacles et décombres -->
    <material name="concrete_debris" rgba="0.55 0.52 0.48 1.0" roughness="0.9"/>
    <material name="military_container" rgba="0.28 0.34 0.25 1.0" roughness="0.5"/>
    <material name="target_crate" rgba="0.75 0.55 0.15 1.0" roughness="0.4"/>
    <material name="hazard_stripe" rgba="0.85 0.75 0.1 1.0"/>
  </asset>

  <worldbody>
    <light pos="0 0 3.5" dir="0 0 -1" directional="true" diffuse="0.8 0.8 0.8"/>
    <light pos="3 0 2.5" dir="-0.5 0 -0.8" directional="false" diffuse="0.6 0.5 0.4"/>

    <!-- Sol tactique principal -->
    <geom name="tactical_ground" size="12 12 0.1" pos="0 0 -0.1" type="plane" material="ground_mat"/>

    <!-- ZONE 1 : Sas / Passage étroit (Gabarit 70 cm DGA/TALOS) à X = 2.0m -->
    <geom name="sas_wall_left" type="box" size="0.2 1.5 0.9" pos="2.0 1.85 0.9" material="military_container"/>
    <geom name="sas_wall_right" type="box" size="0.2 1.5 0.9" pos="2.0 -1.85 0.9" material="military_container"/>
    <!-- Bordures du passage 70 cm -->
    <geom name="sas_post_left" type="cylinder" size="0.06 0.8" pos="2.0 0.35 0.8" material="hazard_stripe"/>
    <geom name="sas_post_right" type="cylinder" size="0.06 0.8" pos="2.0 -0.35 0.8" material="hazard_stripe"/>

    <!-- ZONE 2 : Zone de décombres / Rampe d'assaut tactique (Pente 6° à 10°) à X = 3.5m -->
    <geom name="rubble_ramp_center" type="box" size="0.45 0.32 0.04" pos="3.5 0.00 0.02" euler="0 5 0" material="concrete_debris"/>
    <geom name="rubble_flank_left" type="box" size="0.25 0.22 0.05" pos="3.3 0.36 0.05" euler="6 8 4" material="concrete_debris"/>
    <geom name="rubble_flank_right" type="box" size="0.25 0.22 0.05" pos="3.7 -0.36 0.05" euler="-6 -8 -4" material="concrete_debris"/>

    <!-- ZONE 3 : Caisse d'inspection / Cible tactique à X = 5.0m -->
    <body name="target_zone" pos="5.0 0.0 0.0">
      <geom name="target_box" type="box" size="0.25 0.3 0.35" pos="0 0 0.35" material="target_crate"/>
      <site name="inspection_marker" pos="0 0 0.72" size="0.05" rgba="0.9 0.1 0.1 1.0"/>
    </body>

    <!-- Caméras dédiées pour monitoring C2 -->
    <camera name="tactical_c2" pos="4.5 -3.5 2.8" xyaxes="0.8 0.6 0 -0.3 0.4 0.85"/>
    <camera name="chase_cam" pos="-2.2 0 1.6" xyaxes="0 -1 0 0.4 0 0.9"/>
  </worldbody>
</mujoco>
